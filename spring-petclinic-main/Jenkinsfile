pipeline {
    agent any

    stages {
        stage('Source Code Management') {
            steps {
                // Pulls code from GitHub 
                checkout scm
            }
        }
        stage('Static Analysis') {
            steps {
                // Matches the paper's "Build/Static Analysis" stage [cite: 179]
                echo 'Running static analysis with ESLint/SonarLint...'
            }
        }
        stage('Unit Testing') {
            steps {
                // Focuses on "Functional Suitability" [cite: 76, 247]
                echo 'Executing Unit Tests...'
            }
        }
        stage('Performance Testing') {
            steps {
                // Uses the JMeter you just installed to check "Time Behavior" [cite: 76, 214]
                sh 'jmeter -n -t performance/api_test.jmx -l results.jtl'
            }
        }
        stage('Deployment (CD)') {
            steps {
                // Uses doctl for Digital Ocean to ensure "Installability" [cite: 76, 247]
                echo 'Deploying to Digital Ocean...'
            }
        }
    }
    
    post {
        always {
            // Publishes the HTML reports for the team [cite: 200, 211]
            publishHTML(target: [reportDir: 'results', reportFiles: 'index.html', reportName: 'Quality Report'])
        }
    }
}